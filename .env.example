DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/stellog
APP_SECRET=
APP_URL=http://127.0.0.1:3000
# Stellar secret key for Freighter and xBull. Optional in development.
STELLAR_AUTH_SECRET=
# Hours to keep raw API observations. Hourly and daily aggregates are kept at least 24 months.
STELLOG_RAW_RETENTION_HOURS=48
STELLOG_AGGREGATE_RETENTION_MONTHS=24
# Optional filename served as an alias of public/s/1.js. The hash does not change.
# TRACKER_SCRIPT_NAME=stats/t.js
# Collect path baked into the pinned file at build time. Requires a new version and hash.
# COLLECT_API_ENDPOINT=/s/e
# Local compose database password. The default umami matches a volume already created by docker-compose.yml.
# POSTGRES_PASSWORD=umami
# Where scripts/backup-db.sh writes dumps, and where scripts/ops-check.ts looks for them.
# BACKUP_DIR=backups
# Receiver for the ops profile. Run scripts/render-alertmanager.ts before `docker compose --profile ops up`.
# ALERT_WEBHOOK_URL=https://hooks.example/stellog
# OPS_TEXTFILE=infra/monitoring/textfile/stellog.prom
