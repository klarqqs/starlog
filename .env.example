# Copy to .env and change every value marked CHANGE-ME. Never commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME
# Starlog application roles (created by infra/db/migrations/001_tenancy.sql)
STARLOG_DB_NAME=starlog
STARLOG_TENANT_PASSWORD=CHANGE-ME
STARLOG_OPERATOR_PASSWORD=CHANGE-ME
STARLOG_INGEST_PASSWORD=CHANGE-ME
STARLOG_AUTH_PASSWORD=CHANGE-ME
# Umami baseline (web analytics engine)
UMAMI_DB_NAME=umami
UMAMI_APP_SECRET=CHANGE-ME-long-random-string
# Pin this to an exact version tag or digest before any real deployment.
UMAMI_IMAGE=ghcr.io/umami-software/umami:postgresql-latest
POSTGRES_IMAGE=postgres:16
POSTGRES_PORT=5432
UMAMI_PORT=3000
# Starlog app (landing page, tenant dashboard, operator view)
API_PORT=4000
PUBLIC_URL=http://127.0.0.1:4000
NODE_ENV=development
# Email (verification links). Leave SMTP_HOST empty in development: links print in `make logs`.
# In production (NODE_ENV=production) the API refuses to start without SMTP_HOST.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Starlog <no-reply@your-domain>
