# Copy to /etc/stellog.env on the server. Do not commit the copy.
# Generate APP_SECRET with: openssl rand -base64 32

DATABASE_URL=postgresql://stellog:change-me@127.0.0.1:5432/stellog
APP_SECRET=change-me
APP_URL=https://demo.example.com
DISABLE_TELEMETRY=1
SKIP_BUILD_GEO=1
STELLOG_DEMO_MODE=1
SITE_ADDRESS=demo.example.com
BACKUP_DIR=/var/backups/stellog
